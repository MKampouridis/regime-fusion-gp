#!/bin/bash
# One element of an SGE job array: does task (SGE_TASK_ID - 1) x COUNT of a campaign's plan,
# and the COUNT - 1 tasks after it. Submit from the repository folder, for example:
#
#   mkdir -p logs
#   qsub -t 1-850 -tc 60 -v CAMPAIGN=pilot,PLAN=runs scripts/ceres/tasks.sge
#
# -t 1-N runs N elements (N is printed when the plan is made). CERES requires -tc: at most 60
# elements of an array at once, and about 250 across all of a user's arrays (hpc.essex.ac.uk,
# Grid Engine page). Tasks are safe to repeat: finished runs are skipped, so a failed or
# stopped element is simply submitted again (qsub -t 17 ... for element 17 alone).
#
# No run-time limit is set: all.q has none, and its jobs may be suspended for a while when the
# higher-priority queue is busy, which a wall-clock limit would count against them.
#$ -N rfgp
#$ -S /bin/bash
#$ -q all.q
#$ -cwd
#$ -j y
#$ -o logs/
set -euo pipefail
source "$HOME/miniforge3/etc/profile.d/conda.sh"
conda activate rfgp
export RFGP_DATA_DIR="${RFGP_DATA_DIR:-$HOME/rfgp-data}"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMBA_NUM_THREADS=1
export NUMBA_CACHE_DIR="${TMPDIR:-/tmp}/numba-cache-$USER"   # compiled code kept on the node, not on NFS
COUNT="${COUNT:-1}"
INDEX=$(( (SGE_TASK_ID - 1) * COUNT ))
python -m regime_fusion.engine run-task --campaign "$CAMPAIGN" --plan "$PLAN" --index "$INDEX" --count "$COUNT"
